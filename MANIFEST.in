# Package files are listed explicitly in pyproject.toml
# ([tool.setuptools.package-data]); do not add recursive-include here.
include README.md
include LICENSE
include CHANGELOG.md
include requirements.txt
include pyproject.toml

global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
# Never ship secrets, databases or screenshots, even if a stale
# egg-info/SOURCES.txt lists them.
global-exclude *.key *.secret *.db *.sqlite tmp*.png
